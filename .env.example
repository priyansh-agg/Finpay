# Copy to .env for `docker compose up`. Values below are the local-dev defaults.

# --- Postgres ---
POSTGRES_USER=finpay
POSTGRES_PASSWORD=finpay
POSTGRES_DB=finpay
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Gateway (Spring Boot) ---
GATEWAY_PORT=8080
# HS256 secret for dashboard JWTs. Generate a real one for anything non-local:
#   openssl rand -base64 48
JWT_SECRET=local-dev-only-change-me-0000000000000000000000000000
JWT_TTL_MINUTES=120
# Master key used to HMAC merchant API keys at rest (so a DB leak != usable keys)
API_KEY_PEPPER=local-dev-only-pepper-change-me

# Per-caller rate limit (Redis token bucket)
FINPAY_RL_CAPACITY=120
FINPAY_RL_REFILL=40

# --- ML service ---
ML_SERVICE_PORT=9000
ML_SERVICE_URL=http://ml-service:9000

# --- Ollama (Spring AI, "explain this flag") ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# --- Simulator ---
# DETERMINISTIC uses the tok_* map; PROBABILISTIC uses per-method success rates
SIMULATOR_MODE=DETERMINISTIC
